<!doctype html><html><head><meta charset="utf-8"><title><%= subject %></title></head>
<body style="margin:0;background:#f1ecf8;font-family:Arial,Helvetica,sans-serif;color:#46404c">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:32px 16px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#fffdf9;border-radius:20px;padding:36px 30px">
<tr><td>
  <p style="margin:0 0 6px;color:#8a80b8;font-weight:bold;letter-spacing:.12em;font-size:12px;text-transform:uppercase"><%= eyebrow %></p>
  <h1 style="margin:0 0 18px;font-family:Georgia,serif;font-weight:normal;color:#5a4869;font-size:28px"><%= heading %></h1>
  <% paragraphs.forEach((p) => { %><p style="font-size:16px;line-height:1.6;margin:0 0 14px"><%- p %></p><% }) %>
  <p style="text-align:center;margin:22px 0 26px"><a href="<%= url %>" style="display:inline-block;background:#8a80b8;color:#ffffff;text-decoration:none;font-weight:bold;font-size:17px;padding:16px 30px;border-radius:999px"><%= button %></a></p>
  <% if (typeof note !== 'undefined' && note) { %><p style="font-size:13px;line-height:1.6;color:#7d7486;margin:0"><%= note %></p><% } %>
  <% if (supportEmail) { %><p style="font-size:13px;line-height:1.6;color:#7d7486;margin:10px 0 0">Dúvidas? Responda este e-mail ou escreva para <%= supportEmail %>.</p><% } %>
  <p style="font-size:12px;color:#a59cad;margin:18px 0 0;word-break:break-all">Se o botão não abrir, copie este endereço: <%= url %></p>
</td></tr></table></td></tr></table></body></html>
