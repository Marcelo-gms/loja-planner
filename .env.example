# ------------------------------------------------------------------ app
# A Integrator define PORT sozinha no deploy; localmente usa 3000.
PORT=3000
# Endereço público, sem barra no final (links dos e-mails e retorno do pagamento)
APP_URL=https://www.seudominio.com.br
NODE_ENV=production
# Texto aleatório longo (assina o cookie de login). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ------------------------------------------------------------------ MySQL
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=loja
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------ Asaas
# sandbox (testes) ou production. As chaves de cada ambiente são diferentes.
ASAAS_ENV=sandbox
# Asaas > Integrações > Chave de API
ASAAS_API_KEY=
# Asaas > Integrações > Webhooks > URL: ${APP_URL}/webhooks/asaas
# "Token de autenticação": invente um texto de 32+ caracteres, sem espaços, e repita aqui.
ASAAS_WEBHOOK_TOKEN=

# ------------------------------------------------------------------ oferta
PRODUCT_PRICE=47.00
# Parcelas sem juros no cartão (limitado para cada parcela ficar >= R$ 5,00)
MAX_INSTALLMENTS=12
GUARANTEE_DAYS=7

# ------------------------------------------------------------------ e-mail (SMTP da hospedagem)
# Sem SMTP_HOST os e-mails não são enviados: o conteúdo aparece no log.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Meu Ano Leve <contato@seudominio.com.br>"
SUPPORT_EMAIL=contato@seudominio.com.br

# ------------------------------------------------------------------ painel /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------ entregável
# Pasta gerada por planner/src/generate.js --bundle (a que tem manifest.json)
PRODUCT_DIR=produto
CACHE_DIR=storage/cache
CACHE_DAYS=7
MAX_DOWNLOADS=40
